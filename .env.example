# ============================================================================
# 智桥 (Zhineng-bridge) 环境变量配置模板
# ============================================================================
# 复制此文件为 .env 并根据需要修改配置值
# cp .env.example .env

# ============================================================================
# 网关配置 (ZHIBRIDGE_*)
# ============================================================================

# 网关API Key（必须设置，≥20字符，未设置时网关拒绝所有需认证请求）
ZHIBRIDGE_API_KEY=

# E2E加密 — 敏感路由(linghealth/linglaw)强制客户端加密（生产环境建议true）
ZHIBRIDGE_REQUIRE_ENCRYPTION=false

# 网关监听地址
ZHIBRIDGE_HOST=127.0.0.1

# WebSocket 中继服务器端口
ZHINENG_BRIDGE_PORT=8765

# 最大并发连接数
ZHINENG_BRIDGE_MAX_CONNECTIONS=100

# 会话超时时间（秒）
ZHINENG_BRIDGE_SESSION_TIMEOUT=3600

# 最大会话数
ZHINENG_BRIDGE_MAX_SESSIONS=100

# 心跳间隔（秒）
ZHINENG_BRIDGE_PING_INTERVAL=10

# 心跳超时（秒）
ZHINENG_BRIDGE_PING_TIMEOUT=5

# 启用 WebSocket Secure (WSS)
ZHINENG_BRIDGE_ENABLE_WSS=false

# TLS 证书文件路径（如果启用 WSS）
ZHINENG_BRIDGE_CERT_FILE=/path/to/cert.pem

# TLS 私钥文件路径（如果启用 WSS）
ZHINENG_BRIDGE_KEY_FILE=/path/to/key.pem

# ============================================================================
# 日志配置
# ============================================================================

# 日志级别: DEBUG, INFO, WARNING, ERROR
ZHINENG_BRIDGE_LOG_LEVEL=INFO

# 日志格式: json, console
ZHINENG_BRIDGE_LOG_FORMAT=json

# 日志文件路径（可选，留空则输出到标准输出）
ZHINENG_BRIDGE_LOG_FILE=

# 启用压缩
ZHINENG_BRIDGE_ENABLE_COMPRESSION=true

# 输出缓冲区大小
ZHINENG_BRIDGE_BUFFER_SIZE=100000

# ============================================================================
# CORS 配置
# ============================================================================

# 启用 CORS
ZHINENG_BRIDGE_ENABLE_CORS=false

# 允许的源（逗号分隔）
ZHINENG_BRIDGE_CORS_ORIGINS=

# 允许的 HTTP 方法（逗号分隔）
ZHINENG_BRIDGE_CORS_METHODS=GET,POST,OPTIONS

# ============================================================================
# 安全配置 (ZHINENG_BRIDGE_SECURITY_*)
# ============================================================================

# 启用认证
ZHINENG_BRIDGE_SECURITY_ENABLE_AUTH=false

# 认证类型: token, oauth2
ZHINENG_BRIDGE_SECURITY_AUTH_TYPE=token

# 启用速率限制
ZHINENG_BRIDGE_SECURITY_ENABLE_RATE_LIMIT=true

# 每分钟最大请求数
ZHINENG_BRIDGE_SECURITY_RATE_LIMIT_PER_MINUTE=60

# 每小时最大请求数
ZHINENG_BRIDGE_SECURITY_RATE_LIMIT_PER_HOUR=1000

# 密钥（用于签名等，生产环境必须设置）
ZHINENG_BRIDGE_SECURITY_SECRET_KEY=

# 加密密钥（用于数据加密）
ZHINENG_BRIDGE_SECURITY_ENCRYPTION_KEY=

# 允许的 IP 地址列表（逗号分隔，留空则不限制）
ZHINENG_BRIDGE_SECURITY_ALLOWED_IPS=

# 阻止的 IP 地址列表（逗号分隔）
ZHINENG_BRIDGE_SECURITY_BLOCKED_IPS=

# GitHub OAuth2 客户端 ID
ZHINENG_BRIDGE_SECURITY_GITHUB_OAUTH_CLIENT_ID=

# GitHub OAuth2 客户端密钥
ZHINENG_BRIDGE_SECURITY_GITHUB_OAUTH_CLIENT_SECRET=

# Google OAuth2 客户端 ID
ZHINENG_BRIDGE_SECURITY_GOOGLE_OAUTH_CLIENT_ID=

# Google OAuth2 客户端密钥
ZHINENG_BRIDGE_SECURITY_GOOGLE_OAUTH_CLIENT_SECRET=

# ============================================================================
# 数据库配置 (ZHINENG_BRIDGE_DB_*)
# ============================================================================

# 启用 SQLite
ZHINENG_BRIDGE_DB_ENABLE_SQLITE=true

# SQLite 数据库文件路径
ZHINENG_BRIDGE_DB_PATH=zhineng-bridge.db

# PostgreSQL 主机（留空则不使用）
ZHINENG_BRIDGE_DB_PG_HOST=

# PostgreSQL 端口
ZHINENG_BRIDGE_DB_PG_PORT=5432

# PostgreSQL 数据库名
ZHINENG_BRIDGE_DB_PG_DATABASE=

# PostgreSQL 用户名
ZHINENG_BRIDGE_DB_PG_USER=

# PostgreSQL 密码
ZHINENG_BRIDGE_DB_PG_PASSWORD=

# ============================================================================
# 监控配置 (ZHINENG_BRIDGE_MONITORING_*)
# ============================================================================

# 启用 Prometheus 指标
ZHINENG_BRIDGE_MONITORING_ENABLE_PROMETHEUS=false

# Prometheus 端口
ZHINENG_BRIDGE_MONITORING_PROMETHEUS_PORT=9090

# 启用健康检查
ZHINENG_BRIDGE_MONITORING_ENABLE_HEALTH_CHECK=true

# 健康检查路径
ZHINENG_BRIDGE_MONITORING_HEALTH_CHECK_PATH=/health

# 启用性能监控
ZHINENG_BRIDGE_MONITORING_ENABLE_PERFORMANCE_MONITORING=true

# 性能报告间隔（秒）
ZHINENG_BRIDGE_MONITORING_PERFORMANCE_REPORT_INTERVAL=60

# 启用 HTTP 服务器（用于 OAuth2 回调和健康检查）
ZHINENG_BRIDGE_MONITORING_ENABLE_HTTP_SERVER=true

# HTTP 服务器端口
ZHINENG_BRIDGE_MONITORING_HTTP_PORT=8000

# ============================================================================
# 工作目录
# ============================================================================

# 基础目录
ZHINENG_BRIDGE_BASE_DIR=/home/ai/.zhineng-bridge

# 临时目录
ZHINENG_BRIDGE_TEMP_DIR=/home/ai/.zhineng-bridge/tmp

# ============================================================================
# Python 环境
# ============================================================================

# 禁用 Python 输出缓冲
PYTHONUNBUFFERED=1
