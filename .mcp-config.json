{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless=false",
        "--viewport=1280x720"
      ],
      "disabled": false,
      "alwaysAllow": [
        "read",
        "write"
      ],
      "env": {
        "NODE_ENV": "production"
      }
    }
  }
}
